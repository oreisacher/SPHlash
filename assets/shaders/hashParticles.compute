#version 430

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec4 position;
    vec4 velocity;
    vec4 properties;
};

layout(std430, binding = 0) buffer ParticlesBuffer {
    Particle particles[];
};

layout(std430, binding = 1) buffer HashDataBuffer {
    uvec2 hashData[];
};

uniform float cellSize;
uniform int numParticles;

void main() {
    uint id = gl_GlobalInvocationID.x;

    if (id >= numParticles)
        return;

    // Get cell of particle
    ivec2 cell = ivec2(floor(particles[id].position.xy / cellSize));

    // Calc hash of cell. Compute with signed integers to avoid negative cell coords problems > Convert to uint later
    int hash = cell.x * 73856093 ^ cell.y * 19349663;

    hashData[id] = uvec2(uint(hash), id);
}